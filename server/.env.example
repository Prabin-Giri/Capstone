# ─── Database (AWS RDS MySQL) ────────────────────────────────────────────────
DB_HOST=autograde-db.<id>.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-db-password
DB_NAME=autograde-db
DB_SSL_VERIFY=false

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=https://main.<your-amplify-app-id>.amplifyapp.com

# ─── AWS S3 (File Storage) ────────────────────────────────────────────────────
# Required for production — files persist in S3 across redeploys.
# Without these, files fall back to local disk (dev-only, ephemeral on Render/EC2).
AWS_REGION=us-east-2
AWS_S3_BUCKET=autograde-uploads
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Grader ──────────────────────────────────────────────────────────────────
# 'local' = run code on host machine (works anywhere, no Docker needed)
# 'docker' = run code in Docker containers (requires Docker on the host)
GRADER_RUN_MODE=local

# Optional grader tuning
GRADER_RUN_TIMEOUT_MS=10000
DOCKER_CMD=docker
DOCKER_JAVA_IMAGE=openjdk:17
DOCKER_PYTHON_IMAGE=python:3.12-slim
DOCKER_NODE_IMAGE=node:20-alpine
